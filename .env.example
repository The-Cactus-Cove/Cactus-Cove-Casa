# Copy to .env and fill in. Never commit .env.

# Home Assistant runs with network_mode: host, so the portal reaches it
# through the Docker host gateway.
HA_URL=http://host.docker.internal:8123
# Long-lived access token from a dedicated HA user (Profile → Security).
HA_TOKEN=

# Random 32+ byte secret for signing session cookies and stay links:
#   openssl rand -base64 48
SESSION_SECRET=

# Public origin of the portal (used for cookies and stay links).
PORTAL_ORIGIN=https://stay.cactuscove.casa

# Use a built-in fake Home Assistant instead of the real one (dev/demo).
HA_MOCK=false

# Name of NGINX Proxy Manager's Docker network that the containers join.
PROXY_NETWORK=npm_default
