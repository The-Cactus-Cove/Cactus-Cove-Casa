# Stack variables. In Dockhand, set these on the stack (mark the secret ones
# as secrets). Locally, copy this file to .env; Docker Compose reads it for
# the ${...} values in docker-compose.yml. Never commit .env.

# --- Required -------------------------------------------------------------
# Random 32+ character secret for signing sessions and stay links:
#   openssl rand -base64 48
SESSION_SECRET=

# Long-lived access token from a dedicated HA user (Profile → Security).
HA_TOKEN=

# --- Home Assistant -----------------------------------------------------
# HA's container name on the hass network.
HA_URL=http://homeassistant:8123
# Use a built-in fake house instead of HA (development and demos).
HA_MOCK=false

# --- Site ---------------------------------------------------------------
PORTAL_ORIGIN=https://stay.cactuscove.casa
PROPERTY_TIMEZONE=America/Phoenix

# Shown to guests during their stay.
WIFI_SSID=
WIFI_PASSWORD=
HOST_PHONE=
REVIEW_URL=

# --- Docker networks (must already exist) ------------------------------
PROXY_NETWORK=npm_default
HASS_NETWORK=hass
