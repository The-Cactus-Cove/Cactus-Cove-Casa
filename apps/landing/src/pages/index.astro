---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import QuickFacts from '../components/sections/QuickFacts.astro';
import Photos from '../components/sections/Photos.astro';
import About from '../components/sections/About.astro';
import UnderTheHood from '../components/sections/UnderTheHood.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../content/site';
---

<Base title={`${site.name} · ${site.location}`}>
  <Header />
  <main>
    <Hero />
    <QuickFacts />
    <Photos />
    <About />
    <UnderTheHood />
  </main>
  <Footer />
</Base>
