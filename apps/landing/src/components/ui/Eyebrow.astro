---
/** Small uppercase label above a heading. */
interface Props {
  tone?: 'gold' | 'muted';
}
const { tone = 'gold' } = Astro.props;
---

<span class:list={['eyebrow', tone]}><slot /></span>

<style>
  .eyebrow {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .gold { color: var(--cc-gold); }
  .muted { color: var(--cc-muted); letter-spacing: 2px; font-size: 14px; }
</style>
