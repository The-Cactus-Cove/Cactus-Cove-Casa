---
import Container from '../ui/Container.astro';
import Logo from '../Logo.astro';
import { site } from '../../content/site';
---

<Container as="footer" class="footer">
  <div class="row">
    <Logo size="sm" />
    <span>Questions? <a href={`mailto:${site.email}`}>{site.email}</a></span>
    <span>Staying with us? <a href={site.portalUrl}>Guest portal</a></span>
  </div>
</Container>

<style>
  :global(.footer) { padding-block: 64px 40px; }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 2px dashed var(--cc-dash);
    font-size: 14px;
    color: var(--cc-muted);
  }
</style>
