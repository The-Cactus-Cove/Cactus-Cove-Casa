---
import Container from '../ui/Container.astro';
import PhotoTile from '../ui/PhotoTile.astro';
import { site } from '../../content/site';
---

<Container id="photos" class="section">
  <div class="heading">
    <h2>Take a look around</h2>
    <a href={site.allPhotosUrl} target="_blank" rel="noopener">See all photos →</a>
  </div>
  <ul class="grid">
    {
      site.photos.map((photo) => (
        <li class:list={{ tall: photo.tall }}>
          <PhotoTile photo={photo} />
        </li>
      ))
    }
  </ul>
</Container>

<style>
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .heading { margin-bottom: 24px; }
  .heading a { font-weight: 600; }
  .grid {
    display: grid;
    /* One tall photo plus a 2×2 block fills three columns exactly. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 240px;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li {
    border-radius: 18px;
    overflow: hidden;
  }
  .grid .tall { grid-row: span 2; }
  /* Vary the placeholder shades like the mockup. */
  .grid li:nth-child(3n + 2) :global(.placeholder) { background: #CDB592; }
  .grid li:nth-child(3n) :global(.placeholder) { background: #C4AA85; color: #463528; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; grid-auto-rows: 200px; }
    .grid .tall { grid-row: span 1; }
  }
</style>
